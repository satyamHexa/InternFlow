# ──────────────────────────────────────────────────────────────
#  Intern Flow – Environment Variables Template
#  Copy to .env and fill in values. NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/internflow
POSTGRES_PASSWORD=change_me_strong_password

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://:change_me_redis_password@localhost:6379/0
REDIS_PASSWORD=change_me_redis_password

# ── Security ──────────────────────────────────────────────────
JWT_SECRET=change_me_at_least_32_char_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Azure OpenAI ──────────────────────────────────────────────
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Azure Blob Storage ────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
AZURE_STORAGE_CONTAINER_RESUMES=resumes
AZURE_STORAGE_CONTAINER_DOCUMENTS=documents
AZURE_STORAGE_CONTAINER_CERTIFICATES=certificates

# ── Azure Document Intelligence ───────────────────────────────
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-di.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_key

# ── Email Service ─────────────────────────────────────────────
EMAIL_SERVICE_PROVIDER=sendgrid         # sendgrid | smtp | azure_communication
EMAIL_SERVICE_API_KEY=your_email_api_key
EMAIL_FROM_ADDRESS=noreply@internflow.com
EMAIL_FROM_NAME=Intern Flow

# ── Microsoft Teams Webhook ───────────────────────────────────
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Application ───────────────────────────────────────────────
APP_ENV=development                    # development | staging | production
APP_NAME=InternFlow
APP_VERSION=1.0.0
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# ── Celery ────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:change_me_redis_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:change_me_redis_password@localhost:6379/2

# ── Frontend (Vite) ───────────────────────────────────────────
# In development, leave unset to use the built-in Vite proxy (/api/v1 → http://localhost:8000)
# In production, set to the full backend API base URL
# VITE_API_BASE_URL=https://api.internflow.yourdomain.com/api/v1
